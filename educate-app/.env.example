# Educate: environment variables (names only; NEVER commit real values)
# Copy to .env.local for local dev, or run `vercel env pull .env.local` once the project is linked.

# ── Database: Neon Postgres (required for anything signed-in) ───────────
# Vercel dashboard > educate > Storage (Neon integration), or the Neon console > Connection details.
DATABASE_URL=              # pooled connection string (used by the app)
DATABASE_URL_UNPOOLED=     # direct connection string (use for schema changes / scripts)

# ── Auth: Clerk (required; the app 500s on every page without these) ───
# dashboard.clerk.com > your app > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── AI: Anthropic (required for tutor chat, AI marking, generation) ───
# console.anthropic.com > API Keys (the account needs credit)
ANTHROPIC_API_KEY=

# ── App URL (used for Google Classroom OAuth redirects) ────────────────
# e.g. http://localhost:3000 locally; https://educatethemasses.online in production
NEXT_PUBLIC_APP_URL=

# ── Google Classroom sync (optional) ──────────────────────────────────
# console.cloud.google.com > APIs & Services > Credentials > OAuth client (Web)
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/classroom/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Drive access for past-paper PDFs + scraper (optional) ──────
# GOOGLE_CREDENTIALS_JSON = full contents of the OAuth credentials.json (Google Cloud, Desktop/Web client)
# GOOGLE_TOKEN_JSON       = full contents of token.json (generate with: npx tsx scripts/auth-drive.ts)
GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=
