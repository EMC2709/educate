# Anthropic API Key — get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here

# Auth.js — generate with: npx auth secret
AUTH_SECRET=generate-a-random-secret-here
AUTH_URL=http://localhost:3000

# Microsoft Entra ID (Azure AD) — register at portal.azure.com
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Google OAuth — register at console.cloud.google.com
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
